# Existing PostgreSQL database with timescaledb and vector extensions enabled.
DATABASE_URL=postgres://finance:finance@localhost:5432/finance?sslmode=disable
LISTEN_ADDR=127.0.0.1:8091

# Local development only; requires a loopback LISTEN_ADDR.
# Production identity comes from the trusted router. Leave this empty there.
DEV_VERIFIED_USER=

# Optional comma-separated browser origins allowed by the request origin guard.
# Example: https://finance.example.com. CORS headers are configured at the router.
TRUSTED_ORIGINS=
